{
  "name": "discord-bot-studio",
  "version": "2.0.0",
  "description": "Advanced Discord Bot for Professional Game Development Community",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 stop discord-bot dashboard",
    "restart:pm2": "pm2 restart discord-bot dashboard",
    "logs": "pm2 logs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "discord",
    "discord.js",
    "bot",
    "moderation",
    "tickets",
    "economy",
    "leveling"
  ],
  "author": "FloorsDev",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.0",
    "mongoose": "^8.0.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "node-cron": "^3.0.2",
    "sharp": "^0.33.0",
    "canvas": "^2.11.2",
    "chalk": "^5.3.0",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.45"
  },
  "devDependencies": {
    "typescript": "^5.3.2",
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "ts-node": "^10.9.1",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
